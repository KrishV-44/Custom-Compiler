fn isPrime(n: Int) -> Bool {
    if (n < 2) {
        return false;
    }
    let divisor = 2;
    while (divisor < n) {
        if (n % divisor == 0) {
            return false;
        }
        divisor = divisor + 1;
    }
    return true;
}

let candidate = 2;
while (candidate <= 30) {
    if (isPrime(candidate)) {
        print(candidate);
    }
    candidate = candidate + 1;
}
